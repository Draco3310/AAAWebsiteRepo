---
interface Props {
  athleteName: string;
  category: string;
  startingPoint: string;
  trainingProcess: string;
  outcome: string;
  quote?: string;
  metrics?: { label: string; value: string }[];
}

const {
  athleteName,
  category,
  startingPoint,
  trainingProcess,
  outcome,
  quote,
  metrics = []
} = Astro.props;
---

<div class="bg-[#22252C] rounded-lg p-6 sm:p-8 border border-[#2D313A] shadow-md flex flex-col justify-between hover:border-[#5B35A3]/50 transition-colors">
  <div>
    <!-- Category Badge -->
    <div class="flex items-center justify-between mb-4">
      <span class="text-[11px] font-bold uppercase tracking-widest text-[#5B35A3] bg-[#5B35A3]/10 px-3 py-1 rounded border border-[#5B35A3]/30">
        {category}
      </span>
      <span class="text-xs font-semibold text-[#A7ADB5]">{athleteName}</span>
    </div>

    {quote && (
      <blockquote class="italic text-[#F5F6F7] text-base font-medium mb-6 pl-4 border-l-2 border-[#5B35A3] leading-relaxed">
        "{quote}"
      </blockquote>
    )}

    <!-- Structured Case Study: Starting Point -> Process -> Outcome -->
    <div class="space-y-4 text-sm">
      <div class="bg-[#181A1F] p-3.5 rounded border border-[#2D313A]">
        <span class="text-xs font-bold uppercase tracking-wider text-[#A7ADB5] block mb-1">Starting Point</span>
        <p class="text-[#F5F6F7] leading-relaxed">{startingPoint}</p>
      </div>

      <div class="bg-[#181A1F] p-3.5 rounded border border-[#2D313A]">
        <span class="text-xs font-bold uppercase tracking-wider text-[#5B35A3] block mb-1">Training Process</span>
        <p class="text-[#F5F6F7] leading-relaxed">{trainingProcess}</p>
      </div>

      <div class="bg-[#181A1F] p-3.5 rounded border border-[#2D313A]">
        <span class="text-xs font-bold uppercase tracking-wider text-green-400 block mb-1">Measurable Outcome</span>
        <p class="text-[#F5F6F7] font-semibold leading-relaxed">{outcome}</p>
      </div>
    </div>
  </div>

  {metrics.length > 0 && (
    <div class="grid grid-cols-2 gap-3 mt-6 pt-4 border-t border-[#2D313A]">
      {metrics.map((m) => (
        <div class="text-center p-2 rounded bg-[#181A1F]">
          <span class="text-xs font-medium text-[#A7ADB5] block">{m.label}</span>
          <span class="text-base font-bold text-[#F5F6F7]">{m.value}</span>
        </div>
      ))}
    </div>
  )}
</div>
