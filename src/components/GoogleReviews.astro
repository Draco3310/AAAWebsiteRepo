---
import { fetchGoogleReviews } from '../lib/reviews/google';
import ReviewsEmptyState from './ReviewsEmptyState.astro';

const { reviews, enabled, rating, userRatingCount } = await fetchGoogleReviews();
---

{(!enabled || reviews.length === 0) ? (
  <ReviewsEmptyState />
) : (
  <div class="space-y-8">
    <div class="flex items-center justify-between border-b border-[#2D313A] pb-4">
      <div>
        <h3 class="text-xl font-display font-bold uppercase text-[#F5F6F7]">Verified Google Reviews</h3>
        {rating && (
          <p class="text-xs text-[#A7ADB5] mt-1">
            Rating: <strong class="text-[#F5F6F7]">{rating} / 5</strong> ({userRatingCount} reviews)
          </p>
        )}
      </div>
      <span class="text-xs text-[#858B94]">Sourced via Google Places API</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((r) => (
        <div class="bg-[#22252C] p-6 rounded-lg border border-[#2D313A] space-y-3">
          <div class="flex items-center gap-3">
            {r.authorPhotoUri ? (
              <img src={r.authorPhotoUri} alt={r.authorName} class="w-8 h-8 rounded-full" />
            ) : (
              <div class="w-8 h-8 rounded-full bg-[#5B35A3]/20 border border-[#5B35A3] flex items-center justify-center text-xs font-bold text-[#F5F6F7]">
                {r.authorName.charAt(0)}
              </div>
            )}
            <div>
              <span class="text-sm font-semibold text-[#F5F6F7] block">{r.authorName}</span>
              {r.relativePublishTime && (
                <span class="text-[11px] text-[#858B94]">{r.relativePublishTime}</span>
              )}
            </div>
          </div>
          <p class="text-xs text-[#A7ADB5] leading-relaxed italic">
            "{r.text}"
          </p>
        </div>
      ))}
    </div>
  </div>
)}
