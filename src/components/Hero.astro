---
interface Props {
  eyebrow?: string;
  title: string;
  highlightText?: string;
  subtitle: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  backgroundImage?: string;
  centered?: boolean;
}

const {
  eyebrow = "Colorado Springs • In-Person Performance Coaching",
  title,
  highlightText,
  subtitle,
  primaryCtaText = "Start Your Ascension",
  primaryCtaHref = "/start-here",
  secondaryCtaText = "Explore Coaching",
  secondaryCtaHref = "/coaching",
  backgroundImage,
  centered = false
} = Astro.props;
---

<section class="relative bg-[#181A1F] text-[#F5F6F7] overflow-hidden py-20 lg:py-28 border-b border-[#2D313A]">
  <!-- Subtle Gradient Accent Overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#5B35A3]/20 via-[#181A1F]/80 to-[#181A1F] pointer-events-none"></div>

  {backgroundImage && (
    <div class="absolute inset-0 z-0 opacity-20 bg-cover bg-center" style={`background-image: url('${backgroundImage}')`}>
      <div class="absolute inset-0 bg-[#181A1F]/80 backdrop-blur-[2px]"></div>
    </div>
  )}

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={`max-w-3xl ${centered ? 'mx-auto text-center' : ''}`}>
      
      {eyebrow && (
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#22252C] border border-[#2D313A] text-xs font-semibold text-[#A7ADB5] uppercase tracking-widest mb-6">
          <span class="w-2 h-2 rounded-full bg-[#5B35A3] animate-pulse"></span>
          <span>{eyebrow}</span>
        </div>
      )}

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold tracking-tight text-[#F5F6F7] uppercase leading-[1.1] mb-6">
        {title}
        {highlightText && (
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-[#F5F6F7] via-[#A7ADB5] to-[#5B35A3] mt-1">
            {highlightText}
          </span>
        )}
      </h1>

      <p class="text-lg sm:text-xl text-[#A7ADB5] leading-relaxed mb-8 max-w-2xl">
        {subtitle}
      </p>

      <div class={`flex flex-col sm:flex-row items-stretch sm:items-center gap-4 ${centered ? 'justify-center' : ''}`}>
        {primaryCtaText && (
          <a
            href={primaryCtaHref}
            class="bg-[#5B35A3] hover:bg-[#6E43C2] text-[#F5F6F7] font-semibold text-base px-8 py-4 rounded-md transition-all duration-200 shadow-lg shadow-[#5B35A3]/25 hover:shadow-[#5B35A3]/40 flex items-center justify-center gap-2 group text-center"
          >
            <span>{primaryCtaText}</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        )}

        {secondaryCtaText && (
          <a
            href={secondaryCtaHref}
            class="bg-[#22252C] hover:bg-[#2D313A] border border-[#2D313A] text-[#F5F6F7] font-semibold text-base px-8 py-4 rounded-md transition-colors text-center"
          >
            {secondaryCtaText}
          </a>
        )}
      </div>

    </div>
  </div>
</section>
