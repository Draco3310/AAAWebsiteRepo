---
interface Props {
  heading?: string;
  message?: string;
}

const {
  heading = "Verified Client Stories Are Being Built",
  message = "AAA is currently building its public library of verified client feedback and performance stories. Only approved, real client experiences and documented outcomes will appear here."
} = Astro.props;
---

<div class="bg-[#22252C] rounded-lg p-8 sm:p-12 border border-[#2D313A] max-w-3xl mx-auto text-center space-y-4">
  <div class="w-12 h-12 bg-[#5B35A3]/20 border border-[#5B35A3]/50 rounded-full flex items-center justify-center mx-auto text-[#F5F6F7]">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  </div>
  <h3 class="text-xl sm:text-2xl font-display font-bold uppercase text-[#F5F6F7]">
    {heading}
  </h3>
  <p class="text-sm text-[#A7ADB5] leading-relaxed max-w-xl mx-auto">
    {message}
  </p>
</div>
