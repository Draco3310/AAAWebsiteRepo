---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  centered = true
} = Astro.props;
---

<div class={`mb-12 ${centered ? 'text-center max-w-3xl mx-auto' : 'max-w-3xl'}`}>
  {eyebrow && (
    <span class="text-xs font-semibold uppercase tracking-widest text-[#5B35A3] mb-2 block">
      {eyebrow}
    </span>
  )}
  <h2 class="text-3xl sm:text-4xl font-display font-bold uppercase tracking-tight text-[#F5F6F7] leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 text-base sm:text-lg text-[#A7ADB5] leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
